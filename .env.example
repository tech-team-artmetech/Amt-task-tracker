# Copy these into the hosting panel's environment variables (or into a private .env file).
# Never commit real values.

# Required. Random string, at least 16 characters (use 40+). The server will not start in
# production without it. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Required for reading whiteboard photos with Gemini Vision.
GEMINI_API_KEY=""

# Where the SQLite database file is stored. Use a folder OUTSIDE the website folder and
# outside the app's code folder, e.g. /home/<cpanel-user>/amt-data
DATA_DIR=""

# Web Push (browser notifications). Keep the values you already use so existing
# subscriptions keep working. If you change them, everyone must re-enable notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tech.team@artmetech.in"

# Set automatically by cPanel's Node.js app in "Production" mode; set it yourself elsewhere.
NODE_ENV="production"
# PORT is provided by the host; only set it when running the server yourself.
# PORT=3000
