# GEMINI_API_KEY: Required for Gemini AI vision extraction
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="whiteboard_jwt_secret_change_in_production"

# Cloud SQL PostgreSQL runtime connection (automatically injected by AI Studio / Cloud Run)
SQL_HOST="127.0.0.1"
SQL_DB_NAME="whiteboard"
SQL_USER="postgres"
SQL_PASSWORD="password"

# Schema management admin credentials (used by drizzle-kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="password"
